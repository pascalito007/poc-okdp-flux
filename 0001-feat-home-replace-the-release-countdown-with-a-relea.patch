-<script>
-  const root = document.getElementById("release-countdown");
-
-  if (root) {
-    const target = new Date(root.dataset.release ?? "").getTime();
-    const doneMsg = root.dataset.done ?? "";
-    const days = root.querySelector<HTMLElement>('[data-cd="days"]');
-    const hours = root.querySelector<HTMLElement>('[data-cd="hours"]');
-    const minutes = root.querySelector<HTMLElement>('[data-cd="minutes"]');
-    const seconds = root.querySelector<HTMLElement>('[data-cd="seconds"]');
-    const label = root.querySelector<HTMLElement>("[data-cd-label]");
-
-    if (days && hours && minutes && seconds) {
-      const pad = (value: number) => String(value).padStart(2, "0");
-      let timer: number | undefined;
-
-      const tick = () => {
-        const diff = target - Date.now();
-
-        if (diff <= 0) {
-          days.textContent = "00";
-          hours.textContent = "00";
-          minutes.textContent = "00";
-          seconds.textContent = "00";
-          if (label && doneMsg) label.textContent = doneMsg;
-          if (timer !== undefined) window.clearInterval(timer);
-          return false;
-        }
-
-        const remainingSeconds = Math.floor(diff / 1000);
-        days.textContent = String(Math.floor(remainingSeconds / 86400));
-        hours.textContent = pad(Math.floor((remainingSeconds % 86400) / 3600));
-        minutes.textContent = pad(Math.floor((remainingSeconds % 3600) / 60));
-        seconds.textContent = pad(remainingSeconds % 60);
-        return true;
-      };
-
-      if (tick()) timer = window.setInterval(tick, 1000);
-    }
-  }
-</script>
