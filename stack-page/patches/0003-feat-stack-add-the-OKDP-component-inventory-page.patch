diff --git a/src/lib/stack.ts b/src/lib/stack.ts
new file mode 100644
index 0000000..e9b716e
--- /dev/null
+++ b/src/lib/stack.ts
@@ -0,0 +1,85 @@
+import { getCollection, type CollectionEntry } from "astro:content";
+import type { Locale } from "@/i18n/config";
+import type { HomeTranslations } from "@/i18n/translations";
+import type {
+  LocalizedComponent,
+  LocalizedStack,
+  LocalizedField,
+  SectionId,
+  StackComponent,
+} from "@/types/stack";
+
+const SECTION_ORDER: SectionId[] = [
+  "data-services",
+  "control-plane",
+  "dependencies",
+];
+
+function getLocalizedField(
+  field: LocalizedField | null | undefined,
+  locale: Locale,
+): string | null {
+  if (!field) return null;
+  if (typeof field === "string") return field;
+  return field[locale] || field.en || null;
+}
+
+function localizeComponent(
+  component: StackComponent,
+  locale: Locale,
+): LocalizedComponent {
+  return {
+    ...component,
+    description: getLocalizedField(component.description, locale),
+  };
+}
+
+/** "okdp-1-0" -> "1.0", matching the stack version the generator recorded. */
+export function slugToVersion(slug: string): string {
+  return slug.replace(/^okdp-/, "").replace(/-/g, ".");
+}
+
+export async function getStackEntries(): Promise<CollectionEntry<"stacks">[]> {
+  const entries = await getCollection("stacks");
+  return entries.sort((a, b) =>
+    b.data.stack.localeCompare(a.data.stack, undefined, { numeric: true }),
+  );
+}
+
+export async function getLocalizedStack(
+  slug: string,
+  locale: Locale,
+  content: HomeTranslations,
+): Promise<LocalizedStack | null> {
+  const entries = await getStackEntries();
+  const entry = entries.find((candidate) => candidate.id === slug);
+  if (!entry) return null;
+
+  const components = entry.data.components.map((component) =>
+    localizeComponent(component as StackComponent, locale),
+  );
+
+  const sections = SECTION_ORDER.map((id) => ({
+    id,
+    title: content.stackPage.sections[id].title,
+    description: content.stackPage.sections[id].description,
+    components: components.filter((component) => component.section === id),
+  })).filter((section) => section.components.length > 0);
+
+  return {
+    version: entry.data.stack,
+    slug: entry.id,
+    sections,
+    components,
+    counts: {
+      total: components.length,
+      // The "we don't fork the ecosystem" figure, computed rather than claimed.
+      upstreamOnly: components.filter(
+        (component) =>
+          component.provenance.length === 1 &&
+          component.provenance[0] === "upstream-chart",
+      ).length,
+    },
+    sources: entry.data.generated.sources,
+  };
+}
diff --git a/src/pages/[lang]/stack/[version].astro b/src/pages/[lang]/stack/[version].astro
new file mode 100644
index 0000000..f9b2b90
--- /dev/null
+++ b/src/pages/[lang]/stack/[version].astro
@@ -0,0 +1,167 @@
+---
+import type { GetStaticPaths } from "astro";
+
+import StackSection from "@/components/stack/StackSection.astro";
+import MarketingLayout from "@/layouts/MarketingLayout.astro";
+import { localeCodes, type Locale } from "@/i18n/config";
+import { getTranslations } from "@/i18n/translations";
+import { getLocalizedStack, getStackEntries } from "@/lib/stack";
+
+export const getStaticPaths = (async () => {
+  const entries = await getStackEntries();
+  return localeCodes.flatMap((lang) =>
+    entries.map((entry) => ({ params: { lang, version: entry.id } })),
+  );
+}) satisfies GetStaticPaths;
+
+const locale = Astro.currentLocale as Locale;
+const content = getTranslations(locale);
+const copy = content.stackPage;
+
+const { version } = Astro.params;
+const stack = await getLocalizedStack(version!, locale, content);
+// Unreachable: getStaticPaths only emits routes for entries that exist. Fail
+// the build loudly rather than shipping a blank page if that ever changes.
+if (!stack) throw new Error(`No stack entry for '${version}'`);
+
+const title = copy.title.replace("{version}", stack.version);
+const summary = copy.summary
+  .replace("{total}", String(stack.counts.total))
+  .replace("{upstreamOnly}", String(stack.counts.upstreamOnly));
+
+// Provenance for the reader: which commit of each package repo this inventory
+// was built from, dated so it can be judged without decoding a SHA.
+const dateFormat = new Intl.DateTimeFormat(locale, {
+  day: "numeric",
+  month: "long",
+  year: "numeric",
+});
+const sources = Object.entries(stack.sources).map(([name, source]) => ({
+  name,
+  url: source.url,
+  sha: source.sha.slice(0, 7),
+  date: source.date
+    ? dateFormat.format(new Date(`${source.date}T00:00:00Z`))
+    : null,
+}));
+---
+
+<MarketingLayout
+  content={content}
+  title={copy.meta.title.replace("{version}", stack.version)}
+  description={copy.meta.description}
+>
+  <main>
+    <section class="from-accent to-background bg-linear-to-b pt-36 pb-8">
+      <div class="container">
+        <div class="mx-auto max-w-3xl text-center">
+          <h1 class="text-gradient mb-3">{title}</h1>
+          <p class="text-text-light mb-4">{copy.subtitle}</p>
+          <p class="text-text-light text-sm font-medium">{summary}</p>
+        </div>
+      </div>
+    </section>
+
+    <section class="section bg-background pt-4">
+      <div class="container">
+        <div class="mx-auto max-w-6xl">
+          <div class="mb-8">
+            <label class="sr-only" for="stack-filter">{copy.filter.label}</label
+            >
+            <input
+              id="stack-filter"
+              type="search"
+              autocomplete="off"
+              placeholder={copy.filter.placeholder}
+              class="border-accent bg-background focus:border-primary w-full rounded-lg border px-4 py-2.5 text-sm outline-none md:max-w-md"
+            />
+          </div>
+
+          {
+            stack.sections.map((section) => (
+              <StackSection section={section} content={content} />
+            ))
+          }
+
+          <p
+            class="text-text-light py-10 text-center text-sm"
+            data-stack-empty
+            hidden
+          >
+            {copy.filter.empty}
+          </p>
+
+          <p class="text-text-light border-accent border-t pt-6 text-xs">
+            {copy.generatedFrom}{" "}
+            {
+              sources.map((source, index) => (
+                <>
+                  <a
+                    href={source.url}
+                    class="text-primary font-mono hover:underline"
+                    rel="noopener noreferrer"
+                    target="_blank"
+                  >
+                    {source.name}@{source.sha}
+                  </a>
+                  {source.date && ` (${source.date})`}
+                  {index < sources.length - 1 ? ", " : "."}
+                </>
+              ))
+            }
+          </p>
+        </div>
+      </div>
+    </section>
+  </main>
+</MarketingLayout>
+
+<script>
+  // Progressive enhancement: without JS every component is already visible and
+  // every row still expands, because the rows are <details> elements.
+  const filter = document.querySelector<HTMLInputElement>("#stack-filter");
+  const rows = Array.from(
+    document.querySelectorAll<HTMLDetailsElement>("[data-component]"),
+  );
+  const sections = Array.from(
+    document.querySelectorAll<HTMLElement>("[data-stack-section]"),
+  );
+  const empty = document.querySelector<HTMLElement>("[data-stack-empty]");
+
+  function applyFilter(term: string) {
+    const needle = term.trim().toLowerCase();
+    for (const row of rows) {
+      const match = !needle || (row.dataset.search ?? "").includes(needle);
+      row.hidden = !match;
+      if (!match) row.open = false;
+    }
+    let anyVisible = false;
+    for (const section of sections) {
+      const visible = Array.from(
+        section.querySelectorAll<HTMLDetailsElement>("[data-component]"),
+      ).some((row) => !row.hidden);
+      section.hidden = !visible;
+      anyVisible ||= visible;
+    }
+    if (empty) empty.hidden = anyVisible;
+  }
+
+  filter?.addEventListener("input", () => applyFilter(filter.value));
+
+  for (const button of document.querySelectorAll<HTMLButtonElement>(
+    "[data-copy]",
+  )) {
+    button.addEventListener("click", async () => {
+      try {
+        await navigator.clipboard.writeText(button.dataset.copy ?? "");
+        button.textContent = button.dataset.copyDone ?? "Copied";
+        setTimeout(() => {
+          button.textContent = button.dataset.copyLabel ?? "Copy";
+        }, 1500);
+      } catch {
+        // Clipboard is unavailable (insecure context, denied permission).
+        // The reference stays selectable next to the button.
+      }
+    });
+  }
+</script>
diff --git a/src/pages/[lang]/stack/index.astro b/src/pages/[lang]/stack/index.astro
new file mode 100644
index 0000000..124c493
--- /dev/null
+++ b/src/pages/[lang]/stack/index.astro
@@ -0,0 +1,69 @@
+---
+import type { GetStaticPaths } from "astro";
+import { getRelativeLocaleUrl } from "astro:i18n";
+
+import MarketingLayout from "@/layouts/MarketingLayout.astro";
+import { localeCodes, type Locale } from "@/i18n/config";
+import { getTranslations } from "@/i18n/translations";
+import { getStackEntries } from "@/lib/stack";
+
+export const getStaticPaths = (() => {
+  return localeCodes.map((lang) => ({ params: { lang } }));
+}) satisfies GetStaticPaths;
+
+const locale = Astro.currentLocale as Locale;
+const content = getTranslations(locale);
+const copy = content.stackPage.index;
+
+// Sorted newest first by getStackEntries, so the first entry is the current one.
+const entries = await getStackEntries();
+---
+
+<MarketingLayout
+  content={content}
+  title={copy.meta.title}
+  description={copy.meta.description}
+>
+  <main>
+    <section class="from-accent to-background bg-linear-to-b pt-36 pb-8">
+      <div class="container">
+        <div class="mx-auto max-w-3xl text-center">
+          <h1 class="text-gradient mb-3">{copy.title}</h1>
+          <p class="text-text-light">{copy.subtitle}</p>
+        </div>
+      </div>
+    </section>
+
+    <section class="section bg-background">
+      <div class="container">
+        <div class="mx-auto grid max-w-4xl gap-4 md:grid-cols-2">
+          {
+            entries.map((entry, index) => (
+              <a
+                href={getRelativeLocaleUrl(locale, `/stack/${entry.id}`)}
+                class="bg-background border-accent hover:border-primary group block rounded-lg border p-6 no-underline transition-colors"
+              >
+                <div class="mb-2 flex items-center gap-3">
+                  <h2 class="group-hover:text-primary text-xl font-bold transition-colors">
+                    OKDP {entry.data.stack}
+                  </h2>
+                  {index === 0 && (
+                    <span class="bg-primary/10 text-primary rounded-full px-3 py-0.5 text-xs font-semibold">
+                      {copy.current}
+                    </span>
+                  )}
+                </div>
+                <p class="text-text-light mb-4 text-sm">
+                  {entry.data.components.length} {copy.components}
+                </p>
+                <span class="text-primary text-sm font-medium">
+                  {copy.cta} →
+                </span>
+              </a>
+            ))
+          }
+        </div>
+      </div>
+    </section>
+  </main>
+</MarketingLayout>
diff --git a/src/types/stack.ts b/src/types/stack.ts
new file mode 100644
index 0000000..759245d
--- /dev/null
+++ b/src/types/stack.ts
@@ -0,0 +1,82 @@
+import type { Locale } from "@/i18n/config";
+
+export type LocalizedField = string | Partial<Record<Locale, string>>;
+
+/** How OKDP obtains a component, shown as badges in the Provenance column. */
+export type Provenance = "upstream-chart" | "okdp-chart" | "okdp-image";
+
+export type SectionId = "data-services" | "control-plane" | "dependencies";
+
+export interface ChartRef {
+  name: string;
+  version: string | null;
+  repository: string | null;
+  origin: "upstream" | "okdp" | "local";
+}
+
+export interface ImageRef {
+  repository: string;
+  tag: string;
+}
+
+/** One module of a package: the component itself, or a helper alongside it. */
+export interface ModuleRef {
+  name: string;
+  charts: ChartRef[];
+  images: ImageRef[];
+}
+
+export interface StackComponent {
+  id: string;
+  name: string;
+  section: SectionId;
+  upstreamVersion: string;
+  upstreamVersionSource: string;
+  package: { repository: string; tag: string };
+  provenance: Provenance[];
+  protected: boolean;
+  description: LocalizedField | null;
+  primaryChart: ChartRef | null;
+  primaryImage: ImageRef | null;
+  charts: ChartRef[];
+  images: ImageRef[];
+  modules: ModuleRef[];
+  links: { upstream: string | null; source: string };
+  logo: string | null;
+}
+
+export interface StackSource {
+  sha: string;
+  date: string | null;
+  url: string;
+}
+
+export interface Stack {
+  stack: string;
+  generated: { by: string; note: string; sources: Record<string, StackSource> };
+  components: StackComponent[];
+}
+
+/** A component with its localized strings resolved, ready to render. */
+export interface LocalizedComponent extends Omit<
+  StackComponent,
+  "description"
+> {
+  description: string | null;
+}
+
+export interface LocalizedSection {
+  id: SectionId;
+  title: string;
+  description: string;
+  components: LocalizedComponent[];
+}
+
+export interface LocalizedStack {
+  version: string;
+  slug: string;
+  sections: LocalizedSection[];
+  components: LocalizedComponent[];
+  counts: { total: number; upstreamOnly: number };
+  sources: Record<string, StackSource>;
+}
