    {
      "type": "text",
      "id": "z06-reuse",
      "x": 4755,
      "y": 1715,
      "width": 645.0,
      "height": 110.0,
      "text": "Contrats de connexion et métadonnées de formulaire.\nRéférences de secrets, intégrations existantes, export des valeurs.\nTravail sur les secrets stables et le rendu GitOps.\nRéduction de répétitions pour un profil intégré.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#263238",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
