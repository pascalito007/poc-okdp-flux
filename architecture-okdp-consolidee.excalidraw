    {
      "type": "text",
      "id": "z03-nocodelanguage",
      "x": 3845,
      "y": 950,
      "width": 587.984375,
      "height": 137.5,
      "text": "Pas de nouveau moteur de contrats obligatoire.\nLe Markdown n’injecte pas des valeurs tout seul.\nUn schéma JSON peut valider la forme d’une connexion ;\nil ne prouve ni la disponibilité ni le bon fonctionnement.\nL’automatisation demande un mapping explicite et maintenu.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#7048e8",
      "angle": 0,
      "fillStyle": "solid",
