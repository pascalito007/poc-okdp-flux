      "autoResize": true
    },
    {
      "type": "text",
      "id": "z09-lifecycletext",
      "x": 3850,
      "y": 3485,
      "width": 690.0,
      "height": 137.5,
      "text": "Préparation des artefacts → préconditions → rendu → installation\n→ disponibilité fonctionnelle → exploitation / mise à jour\n→ sauvegarde / restauration → suppression avec conservation choisie.\nDistinguer CRD/opérateur, ressources d’instance et services externes.\nUn opérateur prêt ne garantit pas que sa base ou son client OIDC l’est.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#263238",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 123,
      "version": 1,
      "versionNonce": 1023,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791324000000,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Préparation des artefacts → préconditions → rendu → installation\n→ disponibilité fonctionnelle → exploitation / mise à jour\n→ sauvegarde / restauration → suppression avec conservation choisie.\nDistinguer CRD/opérateur, ressources d’instance et services externes.\nUn opérateur prêt ne garantit pas que sa base ou son client OIDC l’est.",
      "autoResize": true
    },
    {
