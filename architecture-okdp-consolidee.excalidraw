    {
      "type": "text",
      "id": "z04-db",
      "x": 45,
      "y": 2220,
      "width": 666.984375,
      "height": 82.5,
      "text": "Le Hub a une base : PostgreSQL externe n’est pas obligatoire.\nL’exemple utilise SQLite en mémoire ; un rendu minimal a été vérifié.\nCela ne démontre pas un fonctionnement durable ou un spawn réel.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#7048e8",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 115,
      "version": 1,
      "versionNonce": 1015,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791324000000,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Le Hub a une base : PostgreSQL externe n’est pas obligatoire.\nL’exemple utilise SQLite en mémoire ; un rendu minimal a été vérifié.\nCela ne démontre pas un fonctionnement durable ou un spawn réel.",
      "autoResize": true
    },
    {
