    {
      "type": "text",
      "id": "z06-constraints",
      "x": 4755,
      "y": 1950,
      "width": 615.0,
      "height": 110.0,
      "text": "S3 demandé ; generic-oauth fixé / protégé ; exposition intégrée.\nSpark RBAC et ressources ESO apparaissent dans le rendu.\nCe parcours dépasse le premier besoin de notebook minimal.\nCela ne prouve pas que chaque chart possède ces contraintes.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#263238",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
