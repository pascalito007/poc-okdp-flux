    {
      "type": "text",
      "id": "z09-lifecycle",
      "x": 3845,
      "y": 3430,
      "width": 268.0,
      "height": 33.75,
      "text": "Cycle de vie à couvrir",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#1864ab",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
