    {
      "type": "text",
      "id": "z05-roles",
      "x": 1940,
      "y": 2500,
      "width": 1334.0,
      "height": 55.0,
      "text": "Intégrateur : fournit les descripteurs de son outil. OKDP : maintient les recettes communes et les adaptateurs annoncés comme supportés.\nL’interface applicative est partagée ; l’installation, les hooks, les secrets et les suppressions ne sont pas identiques entre moteurs.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#263238",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
