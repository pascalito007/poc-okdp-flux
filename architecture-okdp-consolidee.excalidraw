    {
      "type": "text",
      "id": "z04-otherlist",
      "x": 950,
      "y": 1710,
      "width": 664.984375,
      "height": 165.0,
      "text": "Keycloak : fournisseur d’identité si retenu ; IdP existant possible.\nAirflow : qualifier la base de métadonnées, l’exécuteur et les DAGs.\nTrino + Hive Metastore : distinguer calcul, métadonnées et stockage.\nIngress : qualifier le contrôleur et le mode d’exposition retenus.\nPostgreSQL : installer seulement si le scénario le demande\net si l’institution ne fournit pas déjà le service.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#263238",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 117,
      "version": 1,
      "versionNonce": 1017,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791324000000,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Keycloak : fournisseur d’identité si retenu ; IdP existant possible.\nAirflow : qualifier la base de métadonnées, l’exécuteur et les DAGs.\nTrino + Hive Metastore : distinguer calcul, métadonnées et stockage.\nIngress : qualifier le contrôleur et le mode d’exposition retenus.\nPostgreSQL : installer seulement si le scénario le demande\net si l’institution ne fournit pas déjà le service.",
      "autoResize": true
    },
    {
      "type": "rectangle",
      "id": "z04-tpch",
      "x": 945,
      "y": 1940,
      "width": 805,
      "height": 180,
      "strokeColor": "#64748b",
      "backgroundColor": "#fff9db",
      "strokeWidth": 1.4,
      "roughness": 0,
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 118,
      "version": 1,
      "versionNonce": 1018,
      "isDeleted": false,
