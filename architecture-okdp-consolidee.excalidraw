    {
      "type": "text",
      "id": "z09-local",
      "x": 4755,
      "y": 3035,
      "width": 673.984375,
      "height": 137.5,
      "text": "Rendus JupyterHub : minimal, OIDC/HTTPS, persistance/registre.\nTransport des valeurs Flux/KuboCD ; rendu Helmfile réel.\nScript Helm et commande de rendu CI ; analyse des références Argo.\nEssais ciblés des wrappers et de l’option S3.\nCe sont des preuves locales, pas des déploiements réussis.",
      "fontSize": 22,
      "fontFamily": 2,
      "strokeColor": "#263238",
      "angle": 0,
      "fillStyle": "solid",
      "strokeStyle": "solid",
      "strokeWidth": 1.4,
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 125,
      "version": 1,
      "versionNonce": 1025,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791324000000,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rendus JupyterHub : minimal, OIDC/HTTPS, persistance/registre.\nTransport des valeurs Flux/KuboCD ; rendu Helmfile réel.\nScript Helm et commande de rendu CI ; analyse des références Argo.\nEssais ciblés des wrappers et de l’option S3.\nCe sont des preuves locales, pas des déploiements réussis.",
      "autoResize": true
    },
