      "isDeleted": false,
      "boundElements": null,
      "updated": 1791324000000,
      "link": null,
      "locked": false,
      "backgroundColor": "transparent",
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Intégrateur : fournit les descripteurs de son outil. OKDP : maintient les recettes communes et les adaptateurs annoncés comme supportés.\nL’interface applicative est partagée ; l’installation, les hooks, les secrets et les suppressions ne sont pas identiques entre moteurs.",
      "autoResize": true
    },
